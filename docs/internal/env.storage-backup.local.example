# QuickExit Phase 3C — Storage off-site backup secrets
# Copy to repo root as: .env.storage-backup.local  (gitignored via .env*)
# NEVER commit real values. NEVER put these in Vercel Production or client bundles.

# --- Source (Production Storage READ ONLY) ---
# Prefer dedicated Storage S3 access keys when available (Dashboard → Storage → S3).
# Until then, service role can list/download; it is broader than ideal — keep server-side only.
QE_STORAGE_SOURCE_URL=https://geywuzwbzecknokvnins.supabase.co
QE_STORAGE_SOURCE_SERVICE_ROLE_KEY=

# Optional: Supabase Storage S3 protocol (rclone / aws cli)
# QE_STORAGE_SOURCE_S3_ENDPOINT=https://geywuzwbzecknokvnins.supabase.co/storage/v1/s3
# QE_STORAGE_SOURCE_S3_ACCESS_KEY_ID=
# QE_STORAGE_SOURCE_S3_SECRET_ACCESS_KEY=
# QE_STORAGE_SOURCE_S3_REGION=eu-west-1

# --- Destination: Cloudflare R2 (recommended) ---
QE_STORAGE_BACKUP_PROVIDER=cloudflare-r2
# Account ID used to build endpoint if ENDPOINT left blank:
QE_STORAGE_BACKUP_ACCOUNT_ID=
QE_STORAGE_BACKUP_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
QE_STORAGE_BACKUP_ACCESS_KEY_ID=
QE_STORAGE_BACKUP_SECRET_ACCESS_KEY=
QE_STORAGE_BACKUP_BUCKET=quickexit-storage-backup
QE_STORAGE_BACKUP_REGION=auto
QE_STORAGE_BACKUP_PREFIX=listings
QE_STORAGE_BACKUP_FORCE_PATH_STYLE=true

# Sample sizes
QE_STORAGE_VERIFY_SAMPLE=12
QE_STORAGE_RESTORE_SAMPLE=12
